# Simulator image (pure Python). Build: docker build -t openenv-daw .
# Based on openenv-base (the base the OpenEnv docs and `openenv push` expect). Dependencies come
# from uv.lock, regenerated by scripts/lock_standalone.sh from the monorepo's resolved versions.
ARG BASE_IMAGE=ghcr.io/huggingface/openenv-base:latest
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app
# the package needs Python 3.12; uv fetches it when the base image has an older one
COPY pyproject.toml uv.lock README.md LICENSE ./
RUN uv sync --frozen --no-dev --no-install-project --extra server --extra ui --python 3.12
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --extra server --extra ui --python 3.12

ENV PATH="/app/.venv/bin:$PATH" MAX_CONCURRENT_ENVS=64 PORT=8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000
CMD ["uvicorn", "openenv_daw.server.app:app", "--host", "0.0.0.0", "--port", "8000"]
